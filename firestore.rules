rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // AUTHORIZED TEACHER EMAIL CONFIGURATION
    // -------------------------------------------------------------------------
    // IMPORTANT: Before deploying to production, set this to Ma'am's exact
    // lowercase Gmail address (e.g. "simran.maam@gmail.com") and also set
    // AUTHORIZED_TEACHER_EMAIL in .env / AI Studio Secrets to the same email.
    // Leaving "" permits any verified Google account to access ONLY its own
    // /users/{uid}/... subcollections during initial testing.
    function configuredTeacherEmail() {
      return "";
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedTeacher() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             (configuredTeacherEmail() == "" ||
              request.auth.token.email.lower() == configuredTeacherEmail().lower());
    }

    function isOwner(userId) {
      return isAuthorizedTeacher() && request.auth.uid == userId;
    }

    function isIsoDate(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isYearMonth(val) {
      return val is string && val.size() == 7 && val.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidStudent(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 50 &&
             data.monthlyFeePaise is int && data.monthlyFeePaise >= 0 && data.monthlyFeePaise <= 100000000 &&
             isIsoDate(data.joiningDate) &&
             isYearMonth(data.joiningYearMonth) &&
             data.notes is string && data.notes.size() <= 500 &&
             data.active is bool;
    }

    function isValidFeeRate(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.studentId) &&
             isYearMonth(data.effectiveFrom) &&
             data.monthlyFeePaise is int && data.monthlyFeePaise >= 0 && data.monthlyFeePaise <= 100000000 &&
             data.note is string && data.note.size() <= 200;
    }

    function isValidPaymentMethod(method) {
      return method in ['Cash', 'UPI', 'Bank Transfer', 'Card', 'Cheque', 'Other'];
    }

    function isValidPayment(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.studentId) &&
             data.studentNameSnapshot is string && data.studentNameSnapshot.size() >= 1 && data.studentNameSnapshot.size() <= 100 &&
             data.amountPaise is int && data.amountPaise > 0 && data.amountPaise <= 100000000 &&
             isIsoDate(data.paymentDate) &&
             isYearMonth(data.forYearMonth) &&
             isValidPaymentMethod(data.method) &&
             data.note is string && data.note.size() <= 300;
    }

    function isValidTeacherProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100 &&
             data.tuitionName is string && data.tuitionName.size() >= 1 && data.tuitionName.size() <= 100 &&
             data.teacherEmail is string && data.teacherEmail.size() <= 150 &&
             data.currencyCode == 'INR';
    }

    match /users/{userId} {
      allow read, write: if false;

      match /students/{studentId} {
        allow get: if isOwner(userId) && isValidId(studentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(studentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'name', 'phone', 'className', 'monthlyFeePaise', 'joiningDate', 'joiningYearMonth', 'notes', 'active', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'phone', 'className', 'monthlyFeePaise', 'joiningDate', 'joiningYearMonth', 'notes', 'active', 'createdAt', 'updatedAt']) &&
                         isValidStudent(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(studentId) &&
                         isValidStudent(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'className', 'monthlyFeePaise', 'joiningDate', 'joiningYearMonth', 'notes', 'active', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(studentId);
      }

      match /feeRates/{rateId} {
        allow get: if isOwner(userId) && isValidId(rateId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(rateId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'studentId', 'effectiveFrom', 'monthlyFeePaise', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'studentId', 'effectiveFrom', 'monthlyFeePaise', 'note', 'createdAt', 'updatedAt']) &&
                         isValidFeeRate(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(rateId) &&
                         isValidFeeRate(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().studentId == existing().studentId &&
                         incoming().effectiveFrom == existing().effectiveFrom &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['monthlyFeePaise', 'note', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(rateId);
      }

      match /payments/{paymentId} {
        allow get: if isOwner(userId) && isValidId(paymentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'studentId', 'studentNameSnapshot', 'amountPaise', 'paymentDate', 'forYearMonth', 'method', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'studentId', 'studentNameSnapshot', 'amountPaise', 'paymentDate', 'forYearMonth', 'method', 'note', 'createdAt', 'updatedAt']) &&
                         isValidPayment(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         exists(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         isValidPayment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().studentId == existing().studentId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentNameSnapshot', 'amountPaise', 'paymentDate', 'forYearMonth', 'method', 'note', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(paymentId);
      }

      match /settings/{settingId} {
        allow get: if isOwner(userId) && settingId == 'profile';
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         settingId == 'profile' &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'teacherName', 'tuitionName', 'teacherEmail', 'currencyCode', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'teacherName', 'tuitionName', 'teacherEmail', 'currencyCode', 'createdAt', 'updatedAt']) &&
                         isValidTeacherProfile(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
        allow update: if isOwner(userId) &&
                         settingId == 'profile' &&
                         isValidTeacherProfile(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['teacherName', 'tuitionName', 'teacherEmail', 'currencyCode', 'updatedAt']);
        allow delete: if isOwner(userId) && settingId == 'profile';
      }
    }
  }
}
