# AUTHORIZED_TEACHER_EMAIL: Optional lock restricting app login to a single Gmail account.
# Uncomment and set Ma'am's exact Gmail in .env or the AI Studio Secrets panel
# (and match it in firestore.rules -> configuredTeacherEmail()).
# AUTHORIZED_TEACHER_EMAIL=teacher@gmail.com

# GEMINI_API_KEY: Not used by Simran Tution Classes (kept commented out).
# GEMINI_API_KEY=MY_GEMINI_API_KEY
